{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // ../shared không có node_modules riêng — lấy type của thư viện từ node_modules của package này.
    "paths": {
      "marked": ["./node_modules/marked"],
      "dompurify": ["./node_modules/dompurify"],
      "highlight.js/*": ["./node_modules/highlight.js/*"]
    }
  },
  "include": ["src", "../shared"]
}
